# ─── Keys you must obtain ──────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
SEARCH_API_KEY=tvly-...               # tavily.com — 1000 free credits/mo
SEMANTIC_SCHOLAR_API_KEY=                # optional, blank is fine (raises rate limits only)

# ─── Models ────────────────────────────────────────────────────────
# Hit GET https://api.openai.com/v1/models with your key and pick real, current IDs —
# do not hardcode a model name from memory.
OPENAI_MODEL_REASONING=gpt-5.4-2026-03-05
OPENAI_MODEL_FAST=gpt-5.4-mini-2026-03-17
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                       # must match the pgvector column — never change alone
SEARCH_PROVIDER=tavily                   # or: brave

# ─── Infrastructure ────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://research:changeme@postgres:5432/research
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=research
POSTGRES_PASSWORD=changeme                # compose reads this to init the DB
POSTGRES_DB=research
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
FIGURES_DIR=/data/figures

# ─── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12

# ─── Web / URLs ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PUBLIC_BASE_URL=http://localhost:3000

# ─── Cost & safety limits ──────────────────────────────────────────
MAX_RUN_COST_USD=1.50
MAX_TOOL_CALLS_PER_NODE=8
MAX_FACT_CHECKS_QUICK=10
MAX_FACT_CHECKS_DEEP=40
MAX_FIGURES_PER_REPORT=6
MAX_CITATION_RETRIES=2
MAX_IMAGE_BYTES=5242880
RUN_TIMEOUT_SECONDS=900
TOOL_TIMEOUT_SECONDS=30

# ─── Retrieval tuning ──────────────────────────────────────────────
DEDUPE_THRESHOLD=0.92
TOP_K_PER_SUBQUESTION=8
RRF_K=60
CONTRADICTION_NUMERIC_THRESHOLD=0.15
RERANK_CANDIDATE_LIMIT=30
CLAIM_SIMILARITY_THRESHOLD=0.90
CONTRADICTION_CLUSTER_THRESHOLD=0.75

# ─── Reasoning effort per task tier ────────────────────────────────
EFFORT_EXTRACTION=none
EFFORT_VERIFICATION=low
EFFORT_PLANNING=medium
EFFORT_SYNTHESIS=medium
EFFORT_CONTRADICTION=low

# ─── Ops ───────────────────────────────────────────────────────────
ENV=development
LOG_LEVEL=INFO
